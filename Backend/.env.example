# Project Chanakya -- backend environment template.
#
#   cp .env.example .env      (Backend/.env is git-ignored; never commit it)
#
# config/settings.py loads Backend/.env once at import. Every value below is a
# PLACEHOLDER or the built-in default. A commented-out line means "use the default".
# Booleans accept 1 / true / yes / on (case-insensitive); anything else is false.

# --- Telegram alerts (optional) ---------------------------------------------
# Leave both unset to disable Telegram; incidents are still logged and shown on
# the dashboard. To enable: create a bot with @BotFather, uncomment both lines
# and replace the placeholders. The chat id is the numeric id of the chat that
# should receive alerts. Alert photos leave this machine and are stored by
# Telegram (a third party).
#TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
#TELEGRAM_CHAT_ID=replace-with-numeric-chat-id

# --- Cameras -----------------------------------------------------------------
# Comma-separated id=source pairs. ids: lowercase a-z, 0-9, "_" or "-", at most
# 32 characters, unique, and not the word "default". The display name is the id
# in upper case.
# source is one of:
#   digits only      -> local camera index (0 = built-in webcam)
#   rtsp:// http://  -> network stream; a literal comma inside a URL must be written %2C
#   a file path      -> video file, played at its native FPS and looped (demo mode)
# Stream URLs may contain credentials. They are never logged or returned by the API.
# Default: alpha=0,bravo=1
#CHANAKYA_CAMERAS=alpha=0,bravo=1
#CHANAKYA_CAMERAS=gate=rtsp://user:password@192.0.2.10:554/stream1
#CHANAKYA_CAMERAS=demo=/absolute/path/to/clip.mp4

# --- Storage -----------------------------------------------------------------
# Root for everything the system writes: chanakya.db, snapshots/, videos/,
# reports/, known_faces/, face_encodings.npz, zones.json and secret.key (the
# report-encryption key -- back it up, encrypted reports cannot be recovered
# without it). "~" is expanded and the path is made absolute.
# Contents are NOT encrypted at rest. Default: Backend/database
#CHANAKYA_DATA_DIR=~/chanakya-data

# --- API security -------------------------------------------------------------
# Shared secret for every API route, video stream and download. Send it as
# "Authorization: Bearer <token>" or "?token=<token>" (the query form exists for
# <img>, <video>, EventSource and download links and is redacted from access logs).
# Unset = open mode: only requests whose Host header is 127.0.0.1 / localhost / [::1]
# are served. The server refuses to start on any other CHANAKYA_HOST without a
# token. Use at least 16 random characters, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#CHANAKYA_API_TOKEN=replace-with-at-least-16-random-characters

# Origins allowed to call the API from a browser (CORS), and the only foreign
# origins allowed to send POST/PUT/DELETE. Comma-separated, no trailing slash.
# Default: http://127.0.0.1:5173,http://localhost:5173
#CHANAKYA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Server ------------------------------------------------------------------
# Bind address and port. Keep 127.0.0.1 unless CHANAKYA_API_TOKEN is set.
#CHANAKYA_HOST=127.0.0.1
#CHANAKYA_PORT=5001

# Verbose (DEBUG level) logging only. The Flask debugger and reloader are never
# enabled, whatever this is set to.
#CHANAKYA_DEBUG=false
